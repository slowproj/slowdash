{
    "control": {
        "range": { "length": 300, "to": 0 },
        "reload": 2,
        "mode": "normal",
        "grid": { "rows": 2, "columns": 3 }
    },
    "style": { },
    "panels": [
        { "type": "html", "location": "project", "file": "satrtstop", "title": "PubSub and RPC Controls", "scaling": 1 },
        {
            "type": "timeseries",
            "plots": [
                {
                    "type": "timeseries",
                    "channel": "HV.ch0.V",
                    "color": "#009090",
                    "label": "",
                    "format": "%.5g",
                    "opacity": 1,
                    "marker_type": "circle",
                    "marker_size": 2,
                    "line_width": 1,
                    "line_type": "connect",
                    "include_prior_point": false,
                    "fill_opacity": 0.2,
                    "fill_envelope": true,
                    "fill_baseline": 1e-100,
                    "resampling": { "buckets": 60, "threshold": 1800, "reducer": "last", "envelope": true },
                    "source": { "query": true, "stream": false }
                },
                {
                    "type": "timeseries",
                    "channel": "HV.ch1.V",
                    "color": "#dd8000",
                    "label": "",
                    "format": "%.5g",
                    "opacity": 1,
                    "marker_type": "circle",
                    "marker_size": 2,
                    "line_width": 1,
                    "line_type": "connect",
                    "include_prior_point": false,
                    "fill_opacity": 0,
                    "fill_envelope": false,
                    "fill_baseline": 1e-100,
                    "resampling": { "buckets": null, "threshold": null, "reducer": "last", "envelope": false },
                    "source": { "query": true, "stream": false }
                }
            ],
            "axes": { "xfixed": false, "yfixed": false, "xlog": false, "ylog": false, "zlog": false, "ymin": 3, "ymax": 20, "title": "Stored Data from Database" },
            "legend": { "style": "transparent", "position": "left" }
        },
        {
            "type": "plot",
            "plots": [
                { "type": "histogram", "channel": "histogram.HV.ch0.V", "color": "#009090", "opacity": 0.2, "label": "", "format": "%.5g" },
                { "type": "histogram", "channel": "histogram.HV.ch1.V", "color": "#dd8000", "opacity": 0.2, "label": "", "format": "%.5g" }
            ],
            "axes": { "xfixed": false, "yfixed": false, "xlog": false, "ylog": false, "zlog": false, "xmin": -60, "xmax": 60, "ymin": 0, "ymax": 90, "zmin": 0, "zmax": 1, "title": "Online Analysis Streaming" },
            "legend": { "style": "transparent", "position": "left" }
        },
        {
            "type": "singles",
            "item_type": "square",
            "items": [
                {
                    "channel": "@registry:setup/run/status",
                    "gauge": { "min": 0, "max": 0 },
                    "ranges": {
                        "normal": { "min": 0, "max": 0 },
                        "warn": { "min": 0, "max": 0 },
                        "error": { "min": 0, "max": 0 }
                    },
                    "label": "Run Status (Registry Read)"
                },
                {
                    "channel": "HV.ch0.V",
                    "gauge": { "min": 0, "max": 0 },
                    "ranges": {
                        "normal": { "min": 0, "max": 0 },
                        "warn": { "min": 0, "max": 0 },
                        "error": { "min": 0, "max": 0 }
                    },
                    "label": "HV.ch0.V (Streaming Push)",
                    "format": "%.2f"
                },
                {
                    "channel": "store.disk_usage['used_percent']",
                    "gauge": { "min": 0, "max": 100 },
                    "ranges": {
                        "normal": { "min": 0, "max": 70 },
                        "warn": { "min": 0, "max": 90 },
                        "error": { "min": 0, "max": 100 }
                    },
                    "label": "Disk Usage (Node Variable Pull)",
                    "format": "%.1f %"
                }
            ],
            "color": { "base": "rgb(0, 0, 0)", "normal": "#06b6d4", "warn": "#f59e0b", "error": "#d81b60", "value_opacity": 1, "gauge_opacity": 0.4, "tile_opacity": 0.1 },
            "grid": { "rows": 2, "columns": 0 },
            "margin": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
            "ranges": { "apply_to_value": false, "apply_to_gauge": true, "apply_to_tile": false },
            "title": "Registry, Streaming & Node Pull"
        },
        { "type": "html", "location": "project", "file": "disk_usage", "title": "Disk Usage (config content HTML)", "reload": true },
        { "type": "tree", "channel": "@registry:$pubsub.", "title": "PubSub Last Value Cache (Registry Values)" }
    ],
    "meta": { "name": "control", "title": "", "description": "" }
}
