{
    "control": {
        "range": { "length": 900, "to": 0 },
        "reload": 2,
        "mode": "normal",
        "grid": { "rows": 2, "columns": 3 }
    },
    "style": { },
    "panels": [
        { "type": "html", "location": "project", "file": "satrtstop", "title": "PubSub and RPC Controls" },
        {
            "type": "timeseries",
            "plots": [
                {
                    "type": "timeseries",
                    "channel": "V0",
                    "color": "#009090",
                    "label": "",
                    "format": "%.5g",
                    "opacity": 1,
                    "marker_type": "circle",
                    "marker_size": 2,
                    "line_width": 1,
                    "line_type": "connect",
                    "include_prior_point": false,
                    "fill_opacity": 0,
                    "fill_envelope": false,
                    "fill_baseline": 1e-100,
                    "resampling": { "buckets": null, "threshold": null, "reducer": "last", "envelope": false }
                },
                {
                    "type": "timeseries",
                    "channel": "V1",
                    "color": "#dd8000",
                    "label": "",
                    "format": "%.5g",
                    "opacity": 1,
                    "marker_type": "circle",
                    "marker_size": 2,
                    "line_width": 1,
                    "line_type": "connect",
                    "include_prior_point": false,
                    "fill_opacity": 0,
                    "fill_envelope": false,
                    "fill_baseline": 1e-100,
                    "resampling": { "buckets": null, "threshold": null, "reducer": "last", "envelope": false }
                }
            ],
            "axes": { "xfixed": false, "yfixed": false, "xlog": false, "ylog": false, "zlog": false, "ymin": 3, "ymax": 20, "title": "Stored Data from Database" },
            "legend": { "style": "transparent", "position": "left" }
        },
        {
            "type": "singles",
            "item_type": "square",
            "items": [
                {
                    "channel": "@registry:randomwalk/run/status",
                    "gauge": { "min": 0, "max": 0 },
                    "ranges": {
                        "normal": { "min": 0, "max": 0 },
                        "warn": { "min": 0, "max": 0 },
                        "error": { "min": 0, "max": 0 }
                    },
                    "label": "Run Status (registry value)"
                }
            ],
            "color": { "base": "rgb(0, 0, 0)", "normal": "#06b6d4", "warn": "#f59e0b", "error": "#d81b60", "value_opacity": 1, "gauge_opacity": 0.4, "tile_opacity": 0.1 },
            "grid": { "rows": 0, "columns": 0 },
            "margin": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
            "ranges": { "apply_to_value": false, "apply_to_gauge": true, "apply_to_tile": false }
        },
        { "type": "tree", "channel": "@registry:$pubsub.", "title": "PubSub Last Value Cache (Registry Values)" },
        { "type": "html", "location": "project", "file": "disk_usage", "title": "Disk Usage (config content HTML)", "reload": true },
        {
            "type": "singles",
            "item_type": "square",
            "items": [
                {
                    "channel": "store.disk_usage['used_percent']",
                    "gauge": { "min": 0, "max": 100 },
                    "ranges": {
                        "normal": { "min": 0, "max": 80 },
                        "warn": { "min": 0, "max": 95 },
                        "error": { "min": 0, "max": 100 }
                    },
                    "format": "%d %",
                    "label": "Disk Usage (exported node)"
                }
            ],
            "color": { "base": "rgb(0, 0, 0)", "normal": "#06b6d4", "warn": "#f59e0b", "error": "#d81b60", "value_opacity": 1, "gauge_opacity": 0.4, "tile_opacity": 0.1 },
            "grid": { "rows": 0, "columns": 0 },
            "margin": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
            "ranges": { "apply_to_value": false, "apply_to_gauge": true, "apply_to_tile": false }
        },
        { "type": "html", "location": "project", "file": "no_tasklet", "title": "" }
    ],
    "meta": { "name": "control", "title": "", "description": "" }
}
