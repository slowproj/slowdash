#! /bin/bash

_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SLOWDASH_DIR="$(cd -P "$(dirname "$_SOURCE")/.." && pwd)"

if [ -d "$SLOWDASH_DIR/venv" ]; then
#   echo Running slowtask in venv at "$SLOWDASH_DIR/venv" >&2
   source "$SLOWDASH_DIR/venv/bin/activate"
else
#   echo Running slowtask without venv
   export PYTHONPATH="$SLOWDASH_DIR/lib/slowpy:$PYTHONPATH"
   export PYTHONPATH="$SLOWDASH_DIR/lib/slowlette:$PYTHONPATH"
fi

exec python3 "$SLOWDASH_DIR/app/server/slowdash-task.py" "$@"
